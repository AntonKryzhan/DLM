module std.net_session_verified
import std.net_session_machine
import std.net_adaptive

native {
    record VerifiedProtocolOwned repr(C) { link: AdaptiveSession; spec: NetworkSpec; machine: ProtocolMachine; minor: U32; control: ProtocolControl; system: I32; }
    record VerifiedProtocol repr(C) { inner: Resource<VerifiedProtocolOwned,verified_protocol_dispose>; }
    record VerifiedProtocolStatistics repr(C) { state: U32; phase: U32; authenticated: Bool; sent: U64; received: U64; pending: U32; terminal: Bool; paths: U32; queued: U32; error: NetworkError; }
    fn verified_protocol_release(owned: &mut VerifiedProtocolOwned) -> Unit { unsafe { let raw: &mut NetOpened=resource_get_mut(&mut owned.link.inner);if raw.handle!=zero<OpaqueHandle>() { dlm_adaptive_close(raw.handle);raw.handle=zero<OpaqueHandle>();raw.status=2;raw.system=0; } }owned.control.resources=0;owned.control.authenticated=false; }
    unsafe fn verified_protocol_dispose(owned: &mut VerifiedProtocolOwned) -> Unit { verified_protocol_release(owned); }
    fn verified_protocol_apply(owned: &mut VerifiedProtocolOwned, event: U32, message: U32) -> I32 { let step: ProtocolStep=protocol_transition(&owned.machine,owned.control.state,event,message,owned.control.role);if step.status!=0 { return step.status; }owned.control.state=step.state;owned.control.resources=step.resources;owned.control.authenticated=step.authenticated;let i: USize=protocol_state(&owned.machine,step.state);if i<cast<USize>(owned.machine.state_count) { if owned.machine.states[i].terminal { verified_protocol_release(owned); } }return 0; }
    fn verified_protocol_stop(owned: &mut VerifiedProtocolOwned, status: I32, system: I32) -> I32 { let mut event: U32=9;if status==3 { event=8; }if status==9 { event=10; }let ignored: I32=verified_protocol_apply(owned,event,0);owned.control.status=status;owned.system=system;verified_protocol_release(owned);return status; }
    fn verified_protocol_guard(owned: &mut VerifiedProtocolOwned, now: U64) -> I32 {
        if owned.control.status!=0 { return owned.control.status; }if owned.machine.state_count>32 || owned.machine.transition_count>256 || (owned.control.role!=1 && owned.control.role!=2) { return verified_protocol_stop(owned,4,0); }let i: USize=protocol_state(&owned.machine,owned.control.state);if i>=cast<USize>(owned.machine.state_count) { return verified_protocol_stop(owned,4,0); }let state: ProtocolState=owned.machine.states[i];if state.terminal { return 2; }if state.resources!=owned.control.resources || state.authenticated!=owned.control.authenticated || owned.control.sent>owned.spec.resources.maximum_session_messages || owned.control.received>owned.spec.resources.maximum_session_messages-owned.control.sent { return verified_protocol_stop(owned,4,0); }let clock: I32=protocol_clock(&owned.control,owned.spec.session,now,state.phase);if clock!=0 { return verified_protocol_stop(owned,clock,0); }return 0;
    }
    fn verified_protocol_adopt(link: AdaptiveSession, spec: NetworkSpec, machine: ProtocolMachine, minor: U32, initiator: Bool) -> VerifiedProtocol {
        let now: U64=network_clock_ms();let mut role: U32=1;if !initiator { role=2; }let mut owned: VerifiedProtocolOwned=VerifiedProtocolOwned(move link,spec,machine,minor,ProtocolControl(machine.initial,role,0,false,0,0,now,now,now,0),0);let check: ProtocolCheck=protocol_machine_check(&owned.spec,&owned.machine,minor);let schema: NetworkSpecCheck=network_spec_check(&owned.spec);let mut status: I32=check.status;if schema.status!=0 { status=schema.status; }if status==0 && (owned.spec.proofs.assurance!=1 || (schema.unsupported_security&U32(4294967294))!=0) { status=6; }
        let config: AdaptiveConfig=adaptive_configuration(&owned.link);let stats: AdaptiveStatistics=adaptive_statistics(&owned.link);let opened: NetworkError=adaptive_error(&owned.link);if opened.kind!=0 { status=opened.kind; }if stats.status!=0 { status=stats.status; }
        if status==0 { if config.bounds.max_message<cast<U32>(schema.maximum) || config.bounds.queued_messages<owned.spec.session.maximum_in_flight || config.bounds.channels<owned.spec.resources.transport.channels || stats.backend_limit>owned.spec.resources.transport.memory || config.bounds.memory>owned.spec.resources.transport.memory-stats.backend_limit { status=7; }for index in 0..cast<USize>(owned.machine.state_count) { if owned.machine.states[index].resources>1 { status=6; } }for profile in 1..7 { let caps: U32=optimizer_properties(cast<U32>(profile),config.policy.delivery);if (caps&config.requirements.required)==config.requirements.required && (caps&config.requirements.forbidden)==0 { if (caps&schema.required_properties)!=schema.required_properties || (caps&owned.spec.transport.forbidden)!=0 { status=6; } } } }
        if status==0 { status=verified_protocol_apply(&mut owned,1,0); }if status!=0 { owned.control.status=status;verified_protocol_release(&mut owned); }unsafe { return VerifiedProtocol(resource(move owned)); }
    }
    fn verified_protocol_add(session: &mut VerifiedProtocol, transport: TransportSession, cost: U32) -> AdaptivePathResult {
        unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let status: I32=verified_protocol_guard(owned,network_clock_ms());if status!=0 { transport_close(move transport);return AdaptivePathResult(AdaptivePath(0),NetworkError(status,0,160)); }let link: AdaptiveStatistics=adaptive_statistics(&owned.link);let candidate: TransportStatistics=transport_statistics(&transport);let config: AdaptiveConfig=adaptive_configuration(&owned.link);let limit: USize=owned.spec.resources.transport.memory;if candidate.error.kind!=0 || link.backend_limit>limit || config.bounds.memory>limit-link.backend_limit || candidate.limit>limit-link.backend_limit-config.bounds.memory { transport_close(move transport);return AdaptivePathResult(AdaptivePath(0),NetworkError(7,0,160)); }return adaptive_add(&mut owned.link,move transport,cost); }
    }
    fn verified_protocol_poll(session: &mut VerifiedProtocol, timeout_ms: U32, cancel: &Resource<OpaqueHandle,net_cancel_dispose>) -> NetworkTransfer {
        unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let now: U64=network_clock_ms();let guard: I32=verified_protocol_guard(owned,now);if guard!=0 { return NetworkTransfer(0,NetworkError(guard,0,161)); }let phase: U32=owned.machine.states[protocol_state(&owned.machine,owned.control.state)].phase;let mut remaining: U64=cast<U64>(owned.spec.session.maximum_duration_ms)-(now-owned.control.created);let idle: U64=cast<U64>(owned.spec.session.idle_timeout_ms)-(now-owned.control.activity);if idle<remaining { remaining=idle; }if phase<=2 { let handshake: U64=cast<U64>(owned.spec.session.handshake_timeout_ms)-(now-owned.control.created);if handshake<remaining { remaining=handshake; } }let mut wait: U32=timeout_ms;if wait>60000 { return NetworkTransfer(0,NetworkError(4,0,161)); }if cast<U64>(wait)>remaining { wait=cast<U32>(remaining); }let progress: NetworkTransfer=adaptive_poll(&mut owned.link,wait,cancel);let checked: I32=verified_protocol_guard(owned,network_clock_ms());if checked!=0 { return NetworkTransfer(progress.count,NetworkError(checked,0,161)); }if progress.error.kind!=0 && progress.error.kind!=1 && progress.error.kind!=3 { let failed: I32=verified_protocol_stop(owned,progress.error.kind,progress.error.system);return NetworkTransfer(progress.count,NetworkError(failed,progress.error.system,161)); }let stats: AdaptiveStatistics=adaptive_statistics(&owned.link);if phase==1 && stats.authenticated>0 { let connected: I32=verified_protocol_apply(owned,2,0);if connected!=0 { let failed: I32=verified_protocol_stop(owned,connected,0);return NetworkTransfer(progress.count,NetworkError(failed,0,161)); } }if phase==4 && stats.queued==0 { let drained: I32=verified_protocol_apply(owned,11,0);if drained!=0 { let failed: I32=verified_protocol_stop(owned,drained,0);return NetworkTransfer(progress.count,NetworkError(failed,0,161)); } }return NetworkTransfer(progress.count,NetworkError(0,0,161)); }
    }
    fn verified_protocol_authenticate(session: &mut VerifiedProtocol) -> NetworkError { unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let guard: I32=verified_protocol_guard(owned,network_clock_ms());if guard!=0 { return NetworkError(guard,0,162); }let stats: AdaptiveStatistics=adaptive_statistics(&owned.link);if stats.authenticated==0 || stats.active==0 { return NetworkError(1,0,162); }let status: I32=verified_protocol_apply(owned,3,0);if status==0 { owned.control.activity=network_clock_ms(); }return NetworkError(status,0,162); } }
    fn verified_protocol_send(session: &mut VerifiedProtocol, channel: U32, bytes: Slice<U8>) -> AdaptiveMessage {
        unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let status: I32=verified_protocol_guard(owned,network_clock_ms());if status!=0 { return AdaptiveMessage(0,0,channel,0,NetworkError(status,0,163)); }if len(bytes)<4 { return AdaptiveMessage(0,0,channel,0,NetworkError(11,0,163)); }let id: ProtocolValue=net_read_be(bytes,0,4);if id.status!=0 { return AdaptiveMessage(0,0,channel,0,NetworkError(id.status,0,163)); }let step: ProtocolStep=protocol_transition(&owned.machine,owned.control.state,4,cast<U32>(id.value),owned.control.role);if step.status!=0 { return AdaptiveMessage(0,0,channel,0,NetworkError(step.status,0,163)); }if !protocol_counter(&owned.control,owned.spec.resources.maximum_session_messages) { return AdaptiveMessage(0,0,channel,0,NetworkError(7,0,163)); }let stats: AdaptiveStatistics=adaptive_statistics(&owned.link);if stats.queued>=owned.spec.session.maximum_in_flight { return AdaptiveMessage(0,0,channel,0,NetworkError(1,0,163)); }let plan: CodecPlan=protocol_payload_plan(&owned.spec,owned.minor,cast<U32>(id.value));let checked: CodecShape=codec_scan(&plan,bytes);if checked.error.kind!=0 { return AdaptiveMessage(0,0,channel,0,NetworkError(checked.error.kind,0,163)); }let sent: AdaptiveMessage=adaptive_send(&mut owned.link,channel,bytes);if sent.error.kind==0 { let applied: I32=verified_protocol_apply(owned,4,cast<U32>(id.value));owned.control.sent=owned.control.sent+1;owned.control.activity=network_clock_ms();if applied!=0 { let failed: I32=verified_protocol_stop(owned,applied,0);return AdaptiveMessage(sent.id,sent.sequence,channel,sent.count,NetworkError(failed,0,163)); } }return sent; }
    }
    fn verified_protocol_receive(session: &mut VerifiedProtocol, output: &mut Buffer<U8>) -> AdaptiveDelivery {
        unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let guard: I32=verified_protocol_guard(owned,network_clock_ms());if guard!=0 { return AdaptiveDelivery(0,0,0,0,0,NetworkError(guard,0,164)); }let pending: AdaptiveMessage=adaptive_peek(&owned.link);if pending.error.kind!=0 { return AdaptiveDelivery(pending.id,pending.sequence,pending.channel,0,pending.count,pending.error); }let schema: NetworkSpecCheck=network_spec_check(&owned.spec);if pending.count<4 || pending.count>schema.maximum { let failed: I32=verified_protocol_stop(owned,11,0);return AdaptiveDelivery(pending.id,pending.sequence,pending.channel,0,pending.count,NetworkError(failed,0,164)); }if len(output)<pending.count { return AdaptiveDelivery(pending.id,pending.sequence,pending.channel,0,pending.count,NetworkError(10,0,164)); }let mut scratch: Buffer<U8>=buffer<U8>(pending.count);let received: AdaptiveDelivery=adaptive_receive(&mut owned.link,&mut scratch);if received.error.kind!=0 { return received; }let bytes: Slice<U8>=slice(&scratch,0,received.copied);let id: ProtocolValue=net_read_be(bytes,0,4);let step: ProtocolStep=protocol_transition(&owned.machine,owned.control.state,5,cast<U32>(id.value),owned.control.role);let plan: CodecPlan=protocol_payload_plan(&owned.spec,owned.minor,cast<U32>(id.value));let shape: CodecShape=codec_scan(&plan,bytes);if id.status!=0 || step.status!=0 || shape.error.kind!=0 || !protocol_counter(&owned.control,owned.spec.resources.maximum_session_messages) { let failed: I32=verified_protocol_stop(owned,11,0);return AdaptiveDelivery(received.id,received.sequence,received.channel,0,received.required,NetworkError(failed,0,164)); }for i in 0..received.copied { output[i]=scratch[i]; }let applied: I32=verified_protocol_apply(owned,5,cast<U32>(id.value));owned.control.received=owned.control.received+1;owned.control.activity=network_clock_ms();return AdaptiveDelivery(received.id,received.sequence,received.channel,received.copied,received.required,NetworkError(applied,0,164)); }
    }
    fn verified_protocol_drain(session: &mut VerifiedProtocol) -> NetworkError { unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let guard: I32=verified_protocol_guard(owned,network_clock_ms());if guard!=0 { return NetworkError(guard,0,165); }return NetworkError(verified_protocol_apply(owned,6,0),0,165); } }
    fn verified_protocol_cancel(session: &mut VerifiedProtocol) -> NetworkError { unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);if owned.control.status==9 { return NetworkError(9,0,166); }return NetworkError(verified_protocol_stop(owned,9,0),0,166); } }
    fn verified_protocol_close(session: VerifiedProtocol) -> Unit { resource_close(move session.inner); }
    fn verified_protocol_statistics(session: &VerifiedProtocol) -> VerifiedProtocolStatistics { let owned: &VerifiedProtocolOwned=resource_get(&session.inner);let i: USize=protocol_state(&owned.machine,owned.control.state);let mut phase: U32=6;let mut terminal: Bool=true;if owned.machine.state_count<=32 && i<cast<USize>(owned.machine.state_count) { phase=owned.machine.states[i].phase;terminal=owned.machine.states[i].terminal; }if owned.control.status!=0 { phase=6;terminal=true; }let schema: NetworkSpecCheck=network_spec_check(&owned.spec);let stats: AdaptiveStatistics=adaptive_statistics(&owned.link);return VerifiedProtocolStatistics(owned.control.state,phase,owned.control.authenticated,owned.control.sent,owned.control.received,schema.pending_proofs,terminal,stats.paths,stats.queued,NetworkError(owned.control.status,owned.system,167)); }
    fn verified_protocol_rotate(session: &mut VerifiedProtocol, signer: NodeSigner, record: SignedLocatorRecord) -> NetworkError { unsafe { let owned: &mut VerifiedProtocolOwned=resource_get_mut(&mut session.inner);let guard: I32=verified_protocol_guard(owned,network_clock_ms());if guard!=0 { node_signer_close(move signer);return NetworkError(guard,0,168); }return adaptive_rotate(&mut owned.link,move signer,record); } }
}
