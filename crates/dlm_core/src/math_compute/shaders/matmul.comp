#version 450
#ifdef DLM_DOUBLE
#extension GL_ARB_gpu_shader_fp64 : require
#define Real double
#else
#define Real float
#endif

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Left { Real a[]; };
layout(std430, binding = 1) readonly buffer Right { Real b[]; };
layout(std430, binding = 2) writeonly buffer Output { Real c[]; };
layout(push_constant) uniform Job { uint op, rows, inner, columns, step, offset, paired, bits; } job;

shared Real left_tile[8][8];
shared Real right_tile[8][8];

void main() {
    uint x = gl_LocalInvocationID.x;
    uint y = gl_LocalInvocationID.y;
    uint i = gl_GlobalInvocationID.y;
    uint j = gl_GlobalInvocationID.x;
    precise Real sum = Real(0);
    for (uint start = 0; start < job.inner; start += 8) {
        left_tile[y][x] = i < job.rows && start + x < job.inner ? a[i * job.inner + start + x] : Real(0);
        right_tile[y][x] = j < job.columns && start + y < job.inner ? b[(start + y) * job.columns + j] : Real(0);
        barrier();
        uint count = min(8u, job.inner - start);
        for (uint l = 0; l < count; l++) {
            precise Real product = left_tile[y][l] * right_tile[l][x];
            sum = sum + product;
        }
        barrier();
    }
    if (i < job.rows && j < job.columns) c[i * job.columns + j] = sum;
}
