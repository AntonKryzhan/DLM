module fixtures.dln.nodes
import std.net_discovery

native {
    export fn nodes_identity() -> U32 {
        assert(node_available());let root: NodeKey=node_key_generate();let current: NodeKey=node_key_generate();let public: NodePublicResult=node_public(&root);assert(public.error.kind==0);let id: NodeIdentityResult=node_identity(public.value);assert(id.error.kind==0);
        let now: U64=node_wall_seconds();let mut signer: NodeSigner=node_signer(&root,move current,1,now-1,now+3600);let error: NetworkError=node_signer_error(&signer);assert(error.kind==0);let mut locators: Buffer<NetworkLocator>=buffer<NetworkLocator>(1);locators[0]=NetworkLocator(socket_address_v4(127,0,0,1,19001).value,4,0);let signed: NodeRecordResult=node_record(&mut signer,slice(&locators,0,1),now,300);assert(signed.error.kind==0 && signed.record.sequence==1);
        let mut wire: Buffer<U8>=buffer<U8>(572);let encoded: NetworkTransfer=node_record_encode(signed.record,&mut wire);assert(encoded.error.kind==0 && encoded.count==320);let decoded: NodeRecordResult=node_record_decode(slice(&wire,0,encoded.count),now);assert(decoded.error.kind==0 && decoded.record.sequence==1);
        let mut trust: NodeTrust=node_trust_new(8,16384);let pinned: NetworkError=node_trust_pin(&mut trust,public.value);assert(pinned.kind==0);let accepted: NetworkError=node_trust_accept(&mut trust,signed.record,now);let replay: NetworkError=node_trust_accept(&mut trust,signed.record,now);assert(accepted.kind==0 && replay.kind==13);let found: NodeRecordResult=node_trust_get(&trust,id.value,now);assert(found.error.kind==0);let stats: NodeStoreStatistics=node_trust_statistics(&trust);assert(stats.entries==1 && stats.present==1 && stats.used<=stats.limit);
        let secret: CryptoSecret=crypto_secret_generate(32);let mut sealed: Buffer<U8>=buffer<U8>(136);let backup: NetworkTransfer=node_key_export(&root,&secret,&mut sealed);assert(backup.error.kind==0 && backup.count==136);let restored_key: NodeKey=node_key_restore(&secret,slice(&sealed,0,136));let restored_public: NodePublicResult=node_public(&restored_key);assert(restored_public.error.kind==0);for i in 0..32 { assert(restored_public.value.bytes[i]==public.value.bytes[i]); }let mut snapshot: Buffer<U8>=buffer<U8>(4096);let saved: NetworkTransfer=node_trust_export(&trust,&secret,&mut snapshot);assert(saved.error.kind==0);let imported: NodeTrust=node_trust_import(&secret,slice(&snapshot,0,saved.count),stats.generation,8,16384,now);let restored: NodeRecordResult=node_trust_get(&imported,id.value,now);assert(restored.error.kind==0);
        let mut signature: Buffer<U8>=buffer<U8>(64);let message: Slice<U8>=utf8_bytes("node ABI signature");let sign: NetworkTransfer=node_sign(&root,message,&mut signature);let verify: NetworkError=node_verify(public.value,message,slice(&signature,0,64));assert(sign.error.kind==0 && verify.kind==0);
        let mut local: LogicalIdentity=zero<LogicalIdentity>();local.bytes[0]=1;let binding: Slice<U8>=utf8_bytes("connection transcript 0123456789");let challenge: NodeChallenge=node_connection_challenge(local,id.value,binding,1000);let mut request: Buffer<U8>=buffer<U8>(144);let written: NetworkTransfer=node_connection_write(&challenge,&mut request);assert(written.error.kind==0);let mut proof: Buffer<U8>=buffer<U8>(800);let proved: NetworkTransfer=node_connection_prove(&signer,signed.record,slice(&request,0,144),binding,&mut proof);assert(proved.error.kind==0);let checked: ConnectionIdentity=node_connection_check(move challenge,&mut trust,slice(&proof,0,proved.count));assert(checked.error.kind==0 && checked.epoch==1);
        let resumed: NetworkError=node_signer_resume(&mut signer,signed.record,now);assert(resumed.kind==0);return 1;
    }
    export fn nodes_content() -> U32 {
        let mut cache: ContentCache=content_cache(128,1048576);let error: NetworkError=content_error(&cache);assert(error.kind==0);let mut input: Buffer<U8>=buffer<U8>(5003);for i in 0..5003 { input[i]=cast<U8>(i%256); }let root: ContentResult=content_tree(&mut cache,slice(&input,0,5003),256);assert(root.error.kind==0 && root.leaves==20);let mut output: Buffer<U8>=buffer<U8>(5004);let read: NetworkTransfer=content_read(&mut cache,root.id,0,&mut output);assert(read.error.kind==0 && read.count==5003);for i in 0..5003 { assert(output[i]==input[i]); }
        let proof: ContentProofResult=content_proof(&mut cache,root.id,19);assert(proof.error.kind==0);let verified: NetworkError=content_verify(root.id,proof.proof,slice(&input,4864,139));assert(verified.kind==0);let info: ContentResult=content_info(&mut cache,root.id);assert(info.error.kind==0 && info.size==5003);
        let mut object: Buffer<U8>=buffer<U8>(120);let exported: NetworkTransfer=content_export(&mut cache,root.id,&mut object);assert(exported.error.kind==0 && exported.count==120);let imported: ContentResult=content_import(&mut cache,root.id,slice(&object,0,120));assert(imported.error.kind==0);let block: ContentResult=content_put(&mut cache,utf8_bytes("content ABI"));assert(block.error.kind==0);let stats: NodeStoreStatistics=content_statistics(&cache);assert(stats.used<=stats.limit);content_close(move cache);return 20;
    }
    export fn nodes_discovery() -> U32 {
        let root: NodeKey=node_key_generate();let current: NodeKey=node_key_generate();let now: U64=node_wall_seconds();let signer: NodeSigner=node_signer(&root,move current,1,now-1,now+3600);let trust: NodeTrust=node_trust_new(8,16384);let cache: ContentCache=content_cache(128,1048576);let group: CryptoSecret=crypto_secret_generate(32);let mut network: DiscoveryNetwork=zero<DiscoveryNetwork>();network.bytes[0]=9;let mut node: NodeDiscovery=discovery_open(move signer,move trust,move cache,move group,socket_address_v4(127,0,0,1,0),network,DiscoveryBounds(8,8,3,128,300,1048576));let opened: NetworkError=discovery_error(&node);assert(opened.kind==0);let own: NodeRecordResult=discovery_record(&mut node);assert(own.error.kind==0 && own.record.locators[0].address.port>0);let mut advertised: Buffer<NetworkLocator>=buffer<NetworkLocator>(1);advertised[0]=own.record.locators[0];advertised[0].priority=7;let renewed: NodeRecordResult=discovery_advertise(&mut node,slice(&advertised,0,1));assert(renewed.error.kind==0 && renewed.record.sequence==own.record.sequence+1);
        let public: NodePublicResult=node_public(&root);let pin: NetworkError=discovery_pin(&mut node,public.value);assert(pin.kind==0);let self_record: NetworkError=discovery_bootstrap(&mut node,own.record);assert(self_record.kind==4);let cancel: Resource<OpaqueHandle,net_cancel_dispose>=network_cancel();let poll: NetworkTransfer=discovery_poll(&mut node,0,&cancel);assert(poll.error.kind==0);let resolved: NodeRecordResult=discovery_resolve(&mut node,own.record.identity,100,&cancel);assert(resolved.error.kind==0);
        let published: ContentResult=discovery_publish(&mut node,utf8_bytes("bounded private discovery"),256);assert(published.error.kind==0);let by_id: ContentResult=discovery_get(&mut node,published.id,100,&cancel);assert(by_id.error.kind==0);let local: ContentResult=discovery_fetch(&mut node,own.record.identity,published.id,100,&cancel);assert(local.error.kind==0);let tree: ContentResult=discovery_materialize(&mut node,own.record.identity,published.id,100,&cancel);assert(tree.error.kind==0);let mut output: Buffer<U8>=buffer<U8>(64);let read: NetworkTransfer=discovery_read(&mut node,published.id,0,&mut output);assert(read.error.kind==0 && read.count==25);
        let secret: CryptoSecret=crypto_secret_generate(32);let mut snapshot: Buffer<U8>=buffer<U8>(4096);let saved: NetworkTransfer=discovery_trust_export(&node,&secret,&mut snapshot);assert(saved.error.kind==0);let stats: DiscoveryStatistics=discovery_statistics(&node);assert(stats.status==0 && stats.used<=stats.limit && stats.pins==1);discovery_close(move node);return 1;
    }
    export fn nodes_abort_cleanup() -> Unit {
        let root: NodeKey=node_key_generate();let current: NodeKey=node_key_generate();let now: U64=node_wall_seconds();let signer: NodeSigner=node_signer(&root,move current,1,now-1,now+300);let trust: NodeTrust=node_trust_new(8,16384);let cache: ContentCache=content_cache(128,1048576);let secret: CryptoSecret=crypto_secret_generate(32);let mut network: DiscoveryNetwork=zero<DiscoveryNetwork>();network.bytes[0]=1;let node: NodeDiscovery=discovery_open(move signer,move trust,move cache,move secret,socket_address_v4(127,0,0,1,0),network,DiscoveryBounds(8,8,3,64,60,1048576));let error: NetworkError=discovery_error(&node);assert(error.kind==0);assert(false);
    }
    export fn nodes_record_abi(value: SignedLocatorRecord) -> SignedLocatorRecord { return value; }
