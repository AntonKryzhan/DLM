module fixtures.dln.adaptive
import std.net_tun
import std.net_session_verified
import generated.state_session

native {
    trust "dlm.edge.v1";
    extern "C" fn dlm_adaptive_choose(requirements: TransportRequirements, policy: OptimizerPolicy, values: Ptr<RuntimeWitness>, count: USize, now: U64) -> OptimizerChoice from "dlm.edge.v1" guarantees(NoUnwind);
    record AdaptiveTestPair repr(C) { client: AdaptiveSession; server: AdaptiveSession; cancel: Resource<OpaqueHandle,net_cancel_dispose>; }
    fn adaptive_test_pair() -> AdaptiveTestPair {
        let ar: NodeKey=node_key_generate();let br: NodeKey=node_key_generate();let ak: NodeKey=node_key_generate();let bk: NodeKey=node_key_generate();let ap: NodePublicResult=node_public(&ar);let bp: NodePublicResult=node_public(&br);let now: U64=node_wall_seconds();let mut a: NodeSigner=node_signer(&ar,move ak,1,now-1,now+3600);let mut b: NodeSigner=node_signer(&br,move bk,1,now-1,now+3600);let mut locators: Buffer<NetworkLocator>=buffer<NetworkLocator>(1);locators[0]=NetworkLocator(socket_address_v4(127,0,0,1,19000).value,4,0);let ra: NodeRecordResult=node_record(&mut a,slice(&locators,0,1),now,300);let rb: NodeRecordResult=node_record(&mut b,slice(&locators,0,1),now,300);assert(ra.error.kind==0 && rb.error.kind==0);let mut ta: NodeTrust=node_trust_new(8,16384);let mut tb: NodeTrust=node_trust_new(8,16384);let pa: NetworkError=node_trust_pin(&mut ta,bp.value);let pb: NetworkError=node_trust_pin(&mut tb,ap.value);assert(pa.kind==0 && pb.kind==0);
        let mut config: AdaptiveConfig=adaptive_config();config.bounds=TransportBounds(4096,8,4,1048576);config.handshake_ms=2000;config.idle_ms=10000;config.duration_ms=30000;config.probe_ms=20;config.policy.min_samples=1;config.automatic=false;let mut id: Array<U8,32>=zero<Array<U8,32>>();id[0]=73;let mut client: AdaptiveSession=adaptive_open(move a,move ta,ra.record,rb.record.identity,id,config);let mut server: AdaptiveSession=adaptive_open(move b,move tb,rb.record,ra.record.identity,id,config);let ae: NetworkError=adaptive_error(&client);let be: NetworkError=adaptive_error(&server);assert(ae.kind==0 && be.kind==0);
        let cancel: Resource<OpaqueHandle,net_cancel_dispose>=network_cancel();let mut listener: TcpListener=tcp_listen(socket_address_v4(127,0,0,1,0),8,false);let address: SocketAddressResult=listener_local(&listener);let socket: TcpSocket=tcp_connect_address(address.address,1000);let ready: NetworkReady=listener_wait(&mut listener,1000,&cancel);assert(ready.error.kind==0);let peer: TcpSocket=tcp_accept(&mut listener);let bounds: TransportBounds=adaptive_transport_bounds(config);let raw_a: TransportSession=transport_adopt_tcp(move socket,TransportRequirements(0,0,0),bounds);let raw_b: TransportSession=transport_adopt_tcp(move peer,TransportRequirements(0,0,0),bounds);let ca: AdaptivePathResult=adaptive_add(&mut client,move raw_a,10);let cb: AdaptivePathResult=adaptive_add(&mut server,move raw_b,10);assert(ca.error.kind==0 && cb.error.kind==0);return AdaptiveTestPair(move client,move server,move cancel);
    }
    export fn adaptive_dlm_roundtrip() -> U32 {
        let mut pair: AdaptiveTestPair=adaptive_test_pair();let deadline: U64=network_clock_ms()+3000;let mut a: AdaptiveStatistics=adaptive_statistics(&pair.client);let mut b: AdaptiveStatistics=adaptive_statistics(&pair.server);while a.authenticated==0 || b.authenticated==0 { assert(network_clock_ms()<deadline);let x: NetworkTransfer=adaptive_poll(&mut pair.client,0,&pair.cancel);let y: NetworkTransfer=adaptive_poll(&mut pair.server,0,&pair.cancel);assert(x.error.kind==0 && y.error.kind==0);a=adaptive_statistics(&pair.client);b=adaptive_statistics(&pair.server); }
        let mut bytes: Buffer<U8>=buffer<U8>(1500);for i in 0..1500 { bytes[i]=cast<U8>(i%256); }let sent: AdaptiveMessage=adaptive_send(&mut pair.client,2,slice(&bytes,0,1500));assert(sent.error.kind==0 && sent.id==1);let mut output: Buffer<U8>=buffer<U8>(1501);let mut ready: AdaptiveMessage=adaptive_peek(&pair.server);while ready.error.kind==1 { assert(network_clock_ms()<deadline);let x: NetworkTransfer=adaptive_poll(&mut pair.client,0,&pair.cancel);let y: NetworkTransfer=adaptive_poll(&mut pair.server,0,&pair.cancel);assert(x.error.kind==0 && y.error.kind==0);ready=adaptive_peek(&pair.server); }let received: AdaptiveDelivery=adaptive_receive(&mut pair.server,&mut output);assert(received.error.kind==0 && received.channel==2 && received.copied==1500);for i in 0..1500 { assert(output[i]==bytes[i]); }a=adaptive_statistics(&pair.client);while a.queued>0 { assert(network_clock_ms()<deadline);let x: NetworkTransfer=adaptive_poll(&mut pair.client,0,&pair.cancel);let y: NetworkTransfer=adaptive_poll(&mut pair.server,0,&pair.cancel);a=adaptive_statistics(&pair.client); }let witness: RuntimeWitness=adaptive_witness(&pair.client,AdaptivePath(a.active));assert(witness.ready && witness.properties==183);return 1;
    }
    fn verified_test_spec() -> NetworkSpec { let mut spec: NetworkSpec=State_spec();spec.security.authentication=2;spec.session.authentication_before_data=true;spec.resources.transport.memory=33554432;spec.resources.transport.channels=4;spec.session.maximum_in_flight=2;spec.messages[0].senders=3;return spec; }
    fn verified_test_packet() -> Buffer<U8> { let mut packet: Buffer<U8>=buffer<U8>(28);write_be<U32>(&mut packet,0,1);write_le<U32>(&mut packet,4,0x424d4c44);write_le<U16>(&mut packet,8,2);write_le<U16>(&mut packet,10,0);write_le<U32>(&mut packet,12,1);write_le<U32>(&mut packet,16,8);write_le<U64>(&mut packet,20,U64(18446744073709551615));return move packet; }
    export fn verified_dlm_contracts() -> U32 {
        let pair: AdaptiveTestPair=adaptive_test_pair();let spec: NetworkSpec=verified_test_spec();let machine: ProtocolMachine=protocol_default(&spec,1);let mut client: VerifiedProtocol=verified_protocol_adopt(move pair.client,spec,machine,1,true);let mut server: VerifiedProtocol=verified_protocol_adopt(move pair.server,spec,machine,1,false);let packet: Buffer<U8>=verified_test_packet();let early: AdaptiveMessage=verified_protocol_send(&mut client,0,slice(&packet,0,28));assert(early.error.kind!=0);let mut cs: VerifiedProtocolStatistics=verified_protocol_statistics(&client);let mut ss: VerifiedProtocolStatistics=verified_protocol_statistics(&server);assert(cs.error.kind==0 && ss.error.kind==0);let deadline: U64=network_clock_ms()+3000;
        while cs.phase!=2 || ss.phase!=2 { assert(network_clock_ms()<deadline);let x: NetworkTransfer=verified_protocol_poll(&mut client,0,&pair.cancel);let y: NetworkTransfer=verified_protocol_poll(&mut server,0,&pair.cancel);assert(x.error.kind==0 && y.error.kind==0);cs=verified_protocol_statistics(&client);ss=verified_protocol_statistics(&server); }let ca: NetworkError=verified_protocol_authenticate(&mut client);let sa: NetworkError=verified_protocol_authenticate(&mut server);assert(ca.kind==0 && sa.kind==0);let sent: AdaptiveMessage=verified_protocol_send(&mut client,0,slice(&packet,0,28));assert(sent.error.kind==0);let mut short: Buffer<U8>=buffer<U8>(1);short[0]=165;let mut pending: AdaptiveDelivery=verified_protocol_receive(&mut server,&mut short);
        while pending.error.kind==1 { assert(network_clock_ms()<deadline);let x: NetworkTransfer=verified_protocol_poll(&mut client,0,&pair.cancel);let y: NetworkTransfer=verified_protocol_poll(&mut server,0,&pair.cancel);pending=verified_protocol_receive(&mut server,&mut short); }assert(pending.error.kind==10 && short[0]==165);let mut output: Buffer<U8>=buffer<U8>(28);let received: AdaptiveDelivery=verified_protocol_receive(&mut server,&mut output);assert(received.error.kind==0 && received.copied==28);for i in 0..28 { assert(output[i]==packet[i]); }cs=verified_protocol_statistics(&client);ss=verified_protocol_statistics(&server);assert(cs.authenticated && ss.authenticated && cs.sent==1 && ss.received==1 && (cs.pending&1024)!=0);let cancelled: NetworkError=verified_protocol_cancel(&mut client);assert(cancelled.kind==9);return 2;
    }
    export fn verified_cross_session_replay_is_refused() -> I32 { let pair: AdaptiveTestPair=adaptive_test_pair();let mut spec: NetworkSpec=verified_test_spec();spec.security.replay_scope=2;let machine: ProtocolMachine=protocol_default(&spec,1);let session: VerifiedProtocol=verified_protocol_adopt(move pair.client,spec,machine,1,true);let stats: VerifiedProtocolStatistics=verified_protocol_statistics(&session);return stats.error.kind; }
    export fn optimizer_dlm(r: TransportRequirements, p: OptimizerPolicy, observations: Array<RuntimeWitness,6>, now: U64) -> OptimizerChoice { return optimizer_select(r,p,observations,now); }
    export fn optimizer_dot(r: TransportRequirements, p: OptimizerPolicy, observations: Array<RuntimeWitness,6>, now: U64) -> Array<U8,456> { let mut output: Buffer<U8>=buffer<U8>(456);let status: I32=optimizer_certificate(r,p,observations,now,optimizer_select(r,p,observations,now),&mut output);assert(status==0);let mut result: Array<U8,456>=zero<Array<U8,456>>();for i in 0..456 { result[i]=output[i]; }return result; }
    export fn tun_dlm_invalid_authority() -> I32 { unsafe { let authority: TunAuthority=tun_authorize(false);let mut config: TunConfig=tun_config();config.configure=true;let device: TunDevice=tun_open(move authority,utf8_bytes("DLN-validation"),config);let error: NetworkError=tun_error(&device);return error.kind; } }
    export fn tun_dlm_validator(kind: U32, input: Ptr<U8>, count: USize) -> TunPacket { if count>65571 || (count>0 && input==zero<Ptr<U8>>()) { return TunPacket(0,0,0,0,0,NetworkError(4,0,151)); }let mut bytes: Buffer<U8>=buffer<U8>(count);unsafe { for i in 0..count { bytes[i]=*ptr_offset(input,i); } }return tun_validate(kind,slice(&bytes,0,count)); }
    export fn adaptive_config_abi(value: AdaptiveConfig) -> AdaptiveConfig { return value; }
    export fn tun_config_abi(value: TunConfig) -> TunConfig { return value; }
    export fn optimizer_native(r: TransportRequirements, p: OptimizerPolicy, observations: Array<RuntimeWitness,6>, now: U64) -> OptimizerChoice { unsafe { return dlm_adaptive_choose(r,p,as_raw(borrowed_ptr(&observations[0])),6,now); } }
}
