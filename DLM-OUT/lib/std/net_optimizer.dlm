module std.net_optimizer
import std.net_transport_policy
import std.net_bytes

native {
    record OptimizerPolicy repr(C, version=1) { delivery: U32; latency_weight: U32; loss_weight: U32; throughput_weight: U32; cost_weight: U32; max_age_ms: U32; min_samples: U32; min_hold_ms: U32; hysteresis_percent: U32; }
    record RuntimeWitness repr(C, version=1) { id: U64; at_ms: U64; rtt_us: U64; goodput_bps: U64; samples: U64; loss_ppm: U32; profile: U32; properties: U32; cost: U32; ready: Bool; }
    record OptimizerChoice repr(C, version=1) { id: U64; score: U64; profile: U32; properties: U32; index: U32; status: I32; }
    fn optimizer_policy() -> OptimizerPolicy guarantees(NoAlloc,NoBlocking,NoIO) { return OptimizerPolicy(1,1000,1,0,1,3000,2,1000,10); }
    fn optimizer_properties(profile: U32, delivery: U32) -> U32 guarantees(NoAlloc,NoBlocking,NoIO) { let raw: U32=transport_profile_properties(profile);if raw==0 || delivery>2 { return 0; }if delivery==0 { return raw; }let mut order: U32=2;if delivery==2 { order=64; }return (raw&440)|5|order; }
    fn optimizer_policy_valid(p: OptimizerPolicy) -> Bool guarantees(NoAlloc,NoBlocking,NoIO) { return p.delivery<=2 && p.latency_weight<=1000000 && p.loss_weight<=1000000 && p.throughput_weight<=1000000 && p.cost_weight<=1000000 && (p.latency_weight|p.loss_weight|p.throughput_weight|p.cost_weight)!=0 && p.max_age_ms>0 && p.max_age_ms<=3600000 && p.min_samples>0 && p.min_samples<=1000000 && p.min_hold_ms<=3600000 && p.hysteresis_percent<=100; }
    fn optimizer_witness_valid(o: RuntimeWitness, p: OptimizerPolicy, now: U64) -> Bool guarantees(NoAlloc,NoBlocking,NoIO) { if !o.ready || o.id==0 || optimizer_properties(o.profile,p.delivery)==0 || o.properties!=optimizer_properties(o.profile,p.delivery) || o.cost>1000000 || o.rtt_us>60000000000 || o.goodput_bps>1000000000000 || o.loss_ppm>1000000 || o.samples<cast<U64>(p.min_samples) || o.at_ms>now { return false; }return now-o.at_ms<=cast<U64>(p.max_age_ms); }
    fn optimizer_score(o: RuntimeWitness, p: OptimizerPolicy) -> U64 guarantees(NoAlloc,NoBlocking,NoIO) { if o.rtt_us>60000000000 || o.goodput_bps>1000000000000 || o.loss_ppm>1000000 || o.cost>1000000 || !optimizer_policy_valid(p) { return U64(18446744073709551615); }let mut latency: U64=o.rtt_us/1000;if latency>1000000 { latency=1000000; }let mut bandwidth: U64=1000000000/(o.goodput_bps/1000+1);if bandwidth>1000000 { bandwidth=1000000; }return latency*cast<U64>(p.latency_weight)+cast<U64>(o.loss_ppm)*cast<U64>(p.loss_weight)+bandwidth*cast<U64>(p.throughput_weight)+cast<U64>(o.cost)*cast<U64>(p.cost_weight); }
    fn optimizer_select(r: TransportRequirements, p: OptimizerPolicy, values: Array<RuntimeWitness,6>, now: U64) -> OptimizerChoice guarantees(NoAlloc,NoBlocking,NoIO,BoundedWork) { let mut best: OptimizerChoice=OptimizerChoice(0,0,0,0,0,6);if !transport_requirements_valid(r) || !optimizer_policy_valid(p) { best.status=4;return best; }for i in 0..6 { let o: RuntimeWitness=values[cast<USize>(i)];if !optimizer_witness_valid(o,p,now) { continue; }if (r.required&o.properties)!=r.required || (r.forbidden&o.properties)!=0 { continue; }let score: U64=optimizer_score(o,p);let misses: U32=transport_preference_misses(o.properties,r.preferred);let prior: U32=transport_preference_misses(best.properties,r.preferred);if best.status!=0 || misses<prior || (misses==prior && (score<best.score || (score==best.score && o.id<best.id))) { best=OptimizerChoice(o.id,score,o.profile,o.properties,cast<U32>(i),0); } }return best; }
    fn optimizer_should_switch(current: RuntimeWitness, next: RuntimeWitness, p: OptimizerPolicy, now: U64, switched: U64) -> Bool guarantees(NoAlloc,NoBlocking,NoIO) { if !optimizer_policy_valid(p) || !optimizer_witness_valid(next,p,now) || current.id==next.id || switched>now || now-switched<cast<U64>(p.min_hold_ms) { return false; }if !optimizer_witness_valid(current,p,now) { return true; }return optimizer_score(next,p)*100<optimizer_score(current,p)*cast<U64>(U32(100)-p.hysteresis_percent); }
    fn optimizer_certificate(r: TransportRequirements, p: OptimizerPolicy, values: Array<RuntimeWitness,6>, now: U64, choice: OptimizerChoice, output: &mut Buffer<U8>) -> I32 {
        if len(output)<456 || choice.status<0 { return 4; }output[0]=68;output[1]=79;output[2]=84;output[3]=49;write_be<U32>(output,4,r.required);write_be<U32>(output,8,r.forbidden);write_be<U32>(output,12,r.preferred);write_be<U32>(output,16,p.delivery);write_be<U32>(output,20,p.latency_weight);write_be<U32>(output,24,p.loss_weight);write_be<U32>(output,28,p.throughput_weight);write_be<U32>(output,32,p.cost_weight);write_be<U32>(output,36,p.max_age_ms);write_be<U32>(output,40,p.min_samples);write_be<U32>(output,44,p.min_hold_ms);write_be<U32>(output,48,p.hysteresis_percent);write_be<U64>(output,52,now);write_be<U32>(output,60,6);write_be<U64>(output,64,choice.id);write_be<U64>(output,72,choice.score);write_be<U32>(output,80,choice.profile);write_be<U32>(output,84,choice.properties);write_be<U32>(output,88,choice.index);write_be<U32>(output,92,cast<U32>(choice.status));
        for i in 0..6 { let o: RuntimeWitness=values[cast<USize>(i)];let at: USize=96+cast<USize>(i)*60;write_be<U64>(output,at,o.id);write_be<U64>(output,at+8,o.at_ms);write_be<U64>(output,at+16,o.rtt_us);write_be<U64>(output,at+24,o.goodput_bps);write_be<U64>(output,at+32,o.samples);write_be<U32>(output,at+40,o.loss_ppm);write_be<U32>(output,at+44,o.profile);write_be<U32>(output,at+48,o.properties);write_be<U32>(output,at+52,o.cost);let mut ready: U32=0;if o.ready { ready=1; }write_be<U32>(output,at+56,ready); }return 0;
    }
}
