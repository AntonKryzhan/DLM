// Windows application icon, manifest and file properties.
#include <windows.h>
1 ICON "universe.ico"
1 RT_MANIFEST "universe.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DLM Universe\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "Universe\0"
            VALUE "OriginalFilename", "Universe.exe\0"
            VALUE "ProductName", "DLM Universe\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
