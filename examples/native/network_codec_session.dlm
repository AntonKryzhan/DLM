module examples.native.network_codec_session
import generated.codec_echo
import std.net_spec_compat
import std.net_transport
native {
    fn main() -> Unit {
        let local_spec: NetworkSpec=Echo_spec();let peer_spec: NetworkSpec=Echo_spec();let agreed: NetworkNegotiation=network_spec_negotiate(&local_spec,&peer_spec,true,transport_candidates(1));assert(agreed.status==0 && agreed.minor==1 && agreed.choice.profile==1 && agreed.pending_proofs!=0);
        let cancel: Resource<OpaqueHandle,net_cancel_dispose>=network_cancel();assert(network_cancel_valid(&cancel));let mut listener: TcpListener=tcp_listen(socket_address_v4(127,0,0,1,0),8,false);
        let address: SocketAddressResult=listener_local(&listener);assert(network_ok(&address.error));let mut client: TransportSession=transport_open(agreed.choice,agreed.requirements,agreed.bounds,transport_target(address.address,"","",""),agreed.session.handshake_timeout_ms,&cancel);let opened: NetworkError=transport_error(&client);assert(network_ok(&opened));
        let ready: NetworkReady=listener_wait(&mut listener,1000,&cancel);assert(network_ok(&ready.error));let accepted: TcpSocket=tcp_accept(&mut listener);let mut server: TransportSession=transport_adopt_tcp(move accepted,agreed.requirements,agreed.bounds);let adopted: NetworkError=transport_error(&server);assert(network_ok(&adopted));
        let mut original: EchoMessage1=EchoMessage1_new();let a: CodecError=EchoMessage1_field_1_add(&mut original,42);let b: CodecError=EchoMessage1_field_4_add(&mut original,U64(18446744073709551615));let c: CodecError=EchoMessage1_field_5_add(&mut original,true);let d: CodecError=EchoMessage1_field_7_add(&mut original,utf8_bytes("generated TCP exchange"));let e: CodecError=EchoMessage1_field_9_add(&mut original,I64(-9223372036854775808));assert(a.kind==0 && b.kind==0 && c.kind==0 && d.kind==0 && e.kind==0);
        let mut packet: Buffer<U8>=buffer<U8>(cast<USize>(agreed.bounds.max_message));let encoded: CodecIo=EchoMessage1_encode(&original,&mut packet,0);assert(encoded.error.kind==0);let sent: NetworkTransfer=transport_send(&mut client,0,slice(&packet,0,encoded.count));assert(network_ok(&sent.error));let flushed: NetworkTransfer=transport_poll(&mut client,0,&cancel);let read: NetworkTransfer=transport_poll(&mut server,1000,&cancel);assert(network_ok(&flushed.error) && network_ok(&read.error));
        let mut received: Buffer<U8>=buffer<U8>(len(&packet));let delivery: TransportDelivery=transport_receive(&mut server,&mut received);assert(network_ok(&delivery.error) && delivery.copied==encoded.count);let decoded: EchoMessage1Decoded=EchoMessage1_decode(slice(&received,0,delivery.copied));assert(decoded.error.kind==0 && EchoMessage1_equal(&original,&decoded.value));
        let reply: CodecIo=EchoMessage1_encode(&decoded.value,&mut packet,0);assert(reply.error.kind==0);let returned: NetworkTransfer=transport_send(&mut server,0,slice(&packet,0,reply.count));assert(network_ok(&returned.error));let flushed_reply: NetworkTransfer=transport_poll(&mut server,0,&cancel);let read_reply: NetworkTransfer=transport_poll(&mut client,1000,&cancel);assert(network_ok(&flushed_reply.error) && network_ok(&read_reply.error));let response: TransportDelivery=transport_receive(&mut client,&mut received);assert(network_ok(&response.error));let roundtrip: EchoMessage1Decoded=EchoMessage1_decode(slice(&received,0,response.copied));assert(roundtrip.error.kind==0 && EchoMessage1_equal(&original,&roundtrip.value));
        transport_close(move client);transport_close(move server);listener_close(move listener);resource_close(move cancel);unsafe { let stopped: NetIo=network_provider_shutdown();assert(stopped.status==0); }
        print("generated codec admitted TCP request reply and typed roundtrip OK");
    }
}
