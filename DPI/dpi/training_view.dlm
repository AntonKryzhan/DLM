module dpi.training_view
import dpi.genetics

native {
    record TrainingView repr(C) { elapsed: U32; budget: U32; generation: U32; tested: U32; passed: U32; total: U32; controls_passed: U32; controls_total: U32; attributable: U32; validated: U32; media: U32; phase: U32; browser: U32; method: U64; target: U32; telegram_web_passed: U32; telegram_web_total: U32; telegram_desktop_passed: U32; telegram_desktop_total: U32; mwo_passed: U32; mwo_total: U32; }
    fn training_view(text: Slice<U8>, view: &mut TrainingView) -> Bool {
        let mut v: TrainingView=zero<TrainingView>();let mut at: USize=0;let mut fields: USize=0;if bytes_at(text,0,utf8_bytes("﻿")) { at=3; }
        while at < len(text) { let end: USize=byte_find(text,at,U8(10));let raw: Slice<U8>=slice(&text,at,end-at);let line: Slice<U8>=trimmed(raw);at=end+1;
            let equal: USize=byte_find(line,0,U8(61));if equal == len(line) { continue; }let key: Slice<U8>=slice(&line,0,equal);let value: Slice<U8>=slice(&line,equal+1,len(line)-equal-1);
            if ascii_equal(key,utf8_bytes("Gene")) && len(value) > 0 { let mut gene: Gene=gene_default();if !gene_parse(value,&mut gene) { return false; }v.method=gene_hash(&gene);continue; }
            if ascii_equal(key,utf8_bytes("phase")) { if bytes_equal(value,utf8_bytes("driver_check")) { v.phase=5; }else if bytes_equal(value,utf8_bytes("baseline")) { v.phase=6; }else if bytes_equal(value,utf8_bytes("error")) { v.phase=4; }else if bytes_equal(value,utf8_bytes("completed")) { v.phase=3; }else if bytes_equal(value,utf8_bytes("stopped")) { v.phase=2; }else { v.phase=1; }continue; }
            let mut n: U32=0;let known: Bool=ascii_equal(key,utf8_bytes("mwo_passed")) || ascii_equal(key,utf8_bytes("mwo_total")) || ascii_equal(key,utf8_bytes("MwoHttpPassed")) || ascii_equal(key,utf8_bytes("MwoHttpTotal")) || ascii_equal(key,utf8_bytes("target")) || ascii_equal(key,utf8_bytes("telegram_web_passed")) || ascii_equal(key,utf8_bytes("telegram_web_total")) || ascii_equal(key,utf8_bytes("telegram_desktop_passed")) || ascii_equal(key,utf8_bytes("telegram_desktop_total")) || ascii_equal(key,utf8_bytes("TelegramWebPassed")) || ascii_equal(key,utf8_bytes("TelegramWebTotal")) || ascii_equal(key,utf8_bytes("TelegramDesktopPassed")) || ascii_equal(key,utf8_bytes("TelegramDesktopTotal")) || ascii_equal(key,utf8_bytes("elapsed")) || ascii_equal(key,utf8_bytes("budget")) || ascii_equal(key,utf8_bytes("generation")) || ascii_equal(key,utf8_bytes("tested")) || ascii_equal(key,utf8_bytes("passed")) || ascii_equal(key,utf8_bytes("total")) || ascii_equal(key,utf8_bytes("controls_passed")) || ascii_equal(key,utf8_bytes("controls_total")) || ascii_equal(key,utf8_bytes("attributable")) || ascii_equal(key,utf8_bytes("validated")) || ascii_equal(key,utf8_bytes("media")) || ascii_equal(key,utf8_bytes("ControlsPassed")) || ascii_equal(key,utf8_bytes("ControlsTotal")) || ascii_equal(key,utf8_bytes("MediaTested")) || ascii_equal(key,utf8_bytes("browser")) || ascii_equal(key,utf8_bytes("BrowserTested"));
            if !known { continue; }if !decimal(value,1000000000,&mut n) { return false; }fields=fields+1;
            if ascii_equal(key,utf8_bytes("mwo_passed")) || ascii_equal(key,utf8_bytes("MwoHttpPassed")) { v.mwo_passed=n; }if ascii_equal(key,utf8_bytes("mwo_total")) || ascii_equal(key,utf8_bytes("MwoHttpTotal")) { v.mwo_total=n; }
            if ascii_equal(key,utf8_bytes("target")) { v.target=n; }if ascii_equal(key,utf8_bytes("telegram_web_passed")) || ascii_equal(key,utf8_bytes("TelegramWebPassed")) { v.telegram_web_passed=n; }if ascii_equal(key,utf8_bytes("telegram_web_total")) || ascii_equal(key,utf8_bytes("TelegramWebTotal")) { v.telegram_web_total=n; }if ascii_equal(key,utf8_bytes("telegram_desktop_passed")) || ascii_equal(key,utf8_bytes("TelegramDesktopPassed")) { v.telegram_desktop_passed=n; }if ascii_equal(key,utf8_bytes("telegram_desktop_total")) || ascii_equal(key,utf8_bytes("TelegramDesktopTotal")) { v.telegram_desktop_total=n; }
            if ascii_equal(key,utf8_bytes("elapsed")) { v.elapsed=n; }if ascii_equal(key,utf8_bytes("budget")) { v.budget=n; }if ascii_equal(key,utf8_bytes("generation")) { v.generation=n; }if ascii_equal(key,utf8_bytes("tested")) { v.tested=n; }
            if ascii_equal(key,utf8_bytes("passed")) { v.passed=n; }if ascii_equal(key,utf8_bytes("total")) { v.total=n; }
            if ascii_equal(key,utf8_bytes("controls_passed")) || ascii_equal(key,utf8_bytes("ControlsPassed")) { v.controls_passed=n; }if ascii_equal(key,utf8_bytes("controls_total")) || ascii_equal(key,utf8_bytes("ControlsTotal")) { v.controls_total=n; }
            if ascii_equal(key,utf8_bytes("browser")) || ascii_equal(key,utf8_bytes("BrowserTested")) { v.browser=n; }if ascii_equal(key,utf8_bytes("attributable")) { v.attributable=n; }if ascii_equal(key,utf8_bytes("validated")) { v.validated=n; }if ascii_equal(key,utf8_bytes("media")) || ascii_equal(key,utf8_bytes("MediaTested")) { v.media=n; }
        }if fields == 0 || v.passed > v.total || v.controls_passed > v.controls_total || v.validated > U32(1) || v.media > U32(1) || v.browser > U32(1) || v.target > U32(6) || v.mwo_passed > v.mwo_total || v.telegram_web_passed > v.telegram_web_total || v.telegram_desktop_passed > v.telegram_desktop_total { return false; }*view=v;return true;
    }
    fn training_caption(v: &TrainingView, history: Bool) -> Buffer<U8> {
        let mut b: Buffer<U8>=buffer<U8>(0);if history { bytes_append(&mut b,utf8_bytes("Оценка из файла: ")); }else { if v.target == U32(5) { bytes_append(&mut b,utf8_bytes("HTTPS MWO/CDN: ")); }else if v.target == U32(3) || v.target == U32(4) || v.target == U32(6) { bytes_append(&mut b,utf8_bytes("HTTPS + MTProto TCP/WSS: ")); }else if v.browser == U32(1) { bytes_append(&mut b,utf8_bytes("HTTP + Chromium: ")); }else { bytes_append(&mut b,utf8_bytes("HTTP-пробы: ")); } }
        if v.total == U32(0) || v.attributable == U32(0) { bytes_append(&mut b,utf8_bytes("нет подтверждённого результата")); }
        else { append_number(&mut b,cast<U64>(v.passed));push(&mut b,U8(47));append_number(&mut b,cast<U64>(v.total));bytes_append(&mut b,utf8_bytes(" ("));append_number(&mut b,cast<U64>(v.passed)*U64(100)/cast<U64>(v.total));bytes_append(&mut b,utf8_bytes("%)")); }
        if v.method != U64(0) { bytes_append(&mut b,utf8_bytes(" • метод "));append_number(&mut b,v.method%U64(1000000)); }bytes_append(&mut b,utf8_bytes(" • вариантов "));append_number(&mut b,cast<U64>(v.tested));bytes_append(&mut b,utf8_bytes(" • поколение "));append_number(&mut b,cast<U64>(v.generation));
        if v.validated == U32(1) { bytes_append(&mut b,utf8_bytes("\nЕсть улучшение на повторной проверке протоколов.")); }else { bytes_append(&mut b,utf8_bytes("\nУлучшение относительно контроля пока не подтверждено.")); }return move b;
    }
    fn training_clock(v: &TrainingView) -> Buffer<U8> {
        let mut b: Buffer<U8>=bytes_copy(utf8_bytes("Поиск: "));append_number(&mut b,cast<U64>(v.elapsed/U32(60)));push(&mut b,U8(58));if v.elapsed%U32(60) < U32(10) { push(&mut b,U8(48)); }append_number(&mut b,cast<U64>(v.elapsed%U32(60)));
        bytes_append(&mut b,utf8_bytes(" / "));append_number(&mut b,cast<U64>(v.budget/U32(60)));bytes_append(&mut b,utf8_bytes(" мин • контроль "));append_number(&mut b,cast<U64>(v.controls_passed));push(&mut b,U8(47));append_number(&mut b,cast<U64>(v.controls_total));
        if v.telegram_web_total > U32(0) || v.telegram_desktop_total > U32(0) { bytes_append(&mut b,utf8_bytes(" • TG Web "));append_number(&mut b,cast<U64>(v.telegram_web_passed));push(&mut b,U8(47));append_number(&mut b,cast<U64>(v.telegram_web_total));bytes_append(&mut b,utf8_bytes(" • Desktop "));append_number(&mut b,cast<U64>(v.telegram_desktop_passed));push(&mut b,U8(47));append_number(&mut b,cast<U64>(v.telegram_desktop_total)); }
        else if v.media == U32(0) && v.mwo_total == U32(0) { bytes_append(&mut b,utf8_bytes(" • видео не проверено")); }else if v.media == U32(1) { bytes_append(&mut b,utf8_bytes(" • есть проба видео-CDN")); }if v.mwo_total > U32(0) { bytes_append(&mut b,utf8_bytes(" • MWO HTTPS "));append_number(&mut b,cast<U64>(v.mwo_passed));push(&mut b,U8(47));append_number(&mut b,cast<U64>(v.mwo_total));bytes_append(&mut b,utf8_bytes(" • вход в игре вручную")); }return move b;
    }
}
